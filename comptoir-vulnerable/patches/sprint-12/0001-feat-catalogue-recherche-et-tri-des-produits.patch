+++ b/api/tests/Feature/Account/OrderStatsTest.php
@@ -0,0 +1,34 @@
+<?php
+
+declare(strict_types=1);
+
+use App\Models\Customer;
+use App\Models\Order;
+
+it('résume les commandes du client connecté, hors commandes annulées', function () {
+    $customer = Customer::factory()->create();
+    Order::factory()->for($customer)->create(['total_cents' => 2500, 'placed_at' => '2026-09-01 10:00:00']);
+    Order::factory()->for($customer)->create(['total_cents' => 1000, 'placed_at' => '2026-09-10 10:00:00']);
+    Order::factory()->for($customer)->create(['total_cents' => 9900, 'status' => 'cancelled']);
+    Order::factory()->create(['total_cents' => 50000]);
+
+    $this->actingAs($customer)
+        ->getJson('/api/me/order-stats')
+        ->assertOk()
+        ->assertJsonPath('data.orders_count', 2)
+        ->assertJsonPath('data.total_spent_cents', 3500)
+        ->assertJsonPath('data.last_order_at', fn (string $date) => str_starts_with($date, '2026-09-10T10:00:00'));
+});
+
+it('renvoie des compteurs à zéro pour un client sans commande', function () {
+    $this->actingAs(Customer::factory()->create())
+        ->getJson('/api/me/order-stats')
+        ->assertOk()
+        ->assertJsonPath('data.orders_count', 0)
+        ->assertJsonPath('data.total_spent_cents', 0)
+        ->assertJsonPath('data.last_order_at', null);
+});
+
+it('exige une authentification', function () {
+    $this->getJson('/api/me/order-stats')->assertUnauthorized();
+});
diff --git a/api/tests/Feature/Catalogue/ProductSearchTest.php b/api/tests/Feature/Catalogue/ProductSearchTest.php
