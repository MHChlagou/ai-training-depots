@@ -0,0 +1,41 @@
+<?php
+
+declare(strict_types=1);
+
+use App\Models\Product;
+
+it('filtre les produits sur une partie du nom, sans tenir compte de la casse', function () {
+    Product::factory()->create(['name' => 'Perceuse sans fil 18V']);
+    Product::factory()->create(['name' => 'Foret béton 8 mm']);
+
+    $this->getJson('/api/products?search=PERCEUSE')
+        ->assertOk()
+        ->assertJsonCount(1, 'data')
+        ->assertJsonPath('data.0.name', 'Perceuse sans fil 18V');
+});
+
+it('trie les produits par prix décroissant', function () {
+    Product::factory()->create(['name' => 'Mètre ruban', 'price_cents' => 890]);
+    Product::factory()->create(['name' => 'Scie circulaire', 'price_cents' => 12900]);
+    Product::factory()->create(['name' => 'Niveau à bulle', 'price_cents' => 1250]);
+
+    $this->getJson('/api/products?sort=price_cents&direction=desc')
+        ->assertOk()
+        ->assertJsonPath('data.0.name', 'Scie circulaire')
+        ->assertJsonPath('data.1.name', 'Niveau à bulle')
+        ->assertJsonPath('data.2.name', 'Mètre ruban');
+});
+
+it('pagine le catalogue par 20 produits', function () {
+    Product::factory()->count(25)->create();
+
+    $this->getJson('/api/products')
+        ->assertOk()
+        ->assertJsonCount(20, 'data')
+        ->assertJsonPath('meta.total', 25)
+        ->assertJsonPath('meta.last_page', 2);
+
+    $this->getJson('/api/products?page=2')
+        ->assertOk()
+        ->assertJsonCount(5, 'data');
+});
