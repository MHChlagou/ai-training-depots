+<?php
+
+declare(strict_types=1);
+
+namespace App\Console\Commands;
+
+use App\Models\Category;
+use App\Models\Product;
+use App\Services\Nordis\NordisClient;
+use Illuminate\Console\Command;
+use Illuminate\Support\Str;
+
+class SyncNordisCatalogue extends Command
+{
+    protected $signature = 'nordis:sync
+        {--since= : Date ISO 8601 ; seuls les produits modifiés depuis cette date sont importés}
+        {--dry-run : Affiche le bilan sans rien écrire en base}';
+
+    protected $description = 'Importe le catalogue du fournisseur Nordis (produits, prix, descriptions)';
+
+    public function handle(NordisClient $nordis): int
+    {
+        $dryRun = (bool) $this->option('dry-run');
+        $since = $this->option('since');
+        $counts = ['created' => 0, 'updated' => 0, 'skipped' => 0];
+        $page = 1;
+
+        do {
+            $result = $nordis->catalogue($page, is_string($since) ? $since : null);
+
+            foreach ($result['items'] as $item) {
+                $counts[$this->import($item, $dryRun)]++;
+            }
+
+            $page = $result['next_page'];
+        } while ($page !== null);
+
+        $this->table(['Créés', 'Mis à jour', 'Ignorés'], [array_values($counts)]);
+
+        if ($dryRun) {
+            $this->comment('Simulation : aucune donnée enregistrée.');
+        }
+
+        return self::SUCCESS;
+    }
+
+    /**
+     * @param  array<string, mixed>  $item
+     * @return 'created'|'updated'|'skipped'
+     */
+    private function import(array $item, bool $dryRun): string
+    {
+        if (empty($item['reference']) || empty($item['name']) || ! isset($item['price_cents'])) {
+            return 'skipped';
+        }
+
+        $sku = 'NRD-'.$item['reference'];
+        $product = Product::query()->where('sku', $sku)->first();
+
+        if ($dryRun) {
+            return $product === null ? 'created' : 'updated';
+        }
+
+        $categoryName = (string) ($item['category'] ?? 'Nordis');
+        $category = Category::query()->firstOrCreate(
+            ['slug' => Str::slug($categoryName)],
+            ['name' => $categoryName],
+        );
+
+        $attributes = [
+            'category_id' => $category->id,
+            'name' => (string) $item['name'],
+            // Description fournie en HTML par Nordis (paragraphes, listes, gras) : conservée telle quelle.
+            'description' => $item['description_html'] ?? null,
+            'price_cents' => (int) $item['price_cents'],
+            'stock' => (int) ($item['stock'] ?? 0),
+        ];
+
+        if ($product !== null) {
+            $product->update($attributes);
+
+            return 'updated';
+        }
+
+        Product::query()->create($attributes + [
+            'sku' => $sku,
+            'slug' => Str::slug($attributes['name'].' '.$item['reference']),
+        ]);
+
+        return 'created';
+    }
+}
