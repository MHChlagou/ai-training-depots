+<?php
+
+declare(strict_types=1);
+
+use App\Models\Product;
+use Illuminate\Http\Client\Request;
+use Illuminate\Support\Facades\Http;
+
+beforeEach(function () {
+    config([
+        'services.nordis.base_url' => 'https://api.nordis.example',
+        'services.nordis.token' => 'jeton-de-test',
+    ]);
+});
+
+function catalogueNordis(array $items, ?int $nextPage = null): array
+{
+    return ['data' => $items, 'meta' => ['next_page' => $nextPage]];
+}
+
+it('importe les produits du catalogue Nordis', function () {
+    Http::fake([
+        'api.nordis.example/v2/catalogue*' => Http::response(catalogueNordis([
+            [
+                'reference' => 'A1234',
+                'name' => 'Perceuse à percussion 750 W',
+                'category' => 'Outillage électroportatif',
+                'description_html' => '<p>Mandrin <strong>13 mm</strong>.</p>',
+                'price_cents' => 8990,
+                'stock' => 12,
+            ],
+        ])),
+    ]);
+
+    $this->artisan('nordis:sync')->assertSuccessful();
+
+    $product = Product::query()->where('sku', 'NRD-A1234')->firstOrFail();
+
+    expect($product->name)->toBe('Perceuse à percussion 750 W')
+        ->and($product->price_cents)->toBe(8990)
+        ->and($product->description)->toBe('<p>Mandrin <strong>13 mm</strong>.</p>');
+
+    Http::assertSent(fn (Request $request) => $request->hasHeader('Authorization', 'Bearer jeton-de-test'));
+});
+
+it('met à jour un produit déjà importé, sans doublon, et suit la pagination', function () {
+    Http::fake([
+        'api.nordis.example/v2/catalogue?page=1' => Http::response(catalogueNordis([
+            ['reference' => 'A1', 'name' => 'Vis inox 4x30', 'price_cents' => 990],
+        ], nextPage: 2)),
+        'api.nordis.example/v2/catalogue?page=2' => Http::response(catalogueNordis([
+            ['reference' => 'A1', 'name' => 'Vis inox 4x30', 'price_cents' => 1090],
+            ['name' => 'Produit sans référence', 'price_cents' => 100],
+        ])),
+    ]);
+
+    $this->artisan('nordis:sync')->assertSuccessful();
+
+    expect(Product::query()->where('sku', 'NRD-A1')->count())->toBe(1)
+        ->and(Product::query()->where('sku', 'NRD-A1')->value('price_cents'))->toBe(1090);
+});
+
+it('n\'écrit rien avec --dry-run', function () {
+    Http::fake([
+        'api.nordis.example/*' => Http::response(catalogueNordis([
+            ['reference' => 'B2', 'name' => 'Cheville nylon 8 mm', 'price_cents' => 450],
+        ])),
+    ]);
+
+    $this->artisan('nordis:sync', ['--dry-run' => true])->assertSuccessful();
+
+    expect(Product::query()->where('sku', 'NRD-B2')->exists())->toBeFalse();
+});
