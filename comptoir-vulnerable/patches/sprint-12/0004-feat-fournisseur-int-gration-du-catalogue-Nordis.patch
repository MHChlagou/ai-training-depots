@@ -0,0 +1,46 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Services\Nordis;
+
+use Illuminate\Http\Client\PendingRequest;
+use Illuminate\Support\Facades\Http;
+
+/**
+ * Client de l'API catalogue du fournisseur Nordis.
+ */
+class NordisClient
+{
+    private string $token;
+
+    public function __construct()
+    {
+        $this->token = (string) config('services.nordis.token');
+    }
+
+    /**
+     * Une page du catalogue, éventuellement limitée aux produits modifiés depuis une date.
+     *
+     * @return array{items: list<array<string, mixed>>, next_page: int|null}
+     */
+    public function catalogue(int $page = 1, ?string $since = null): array
+    {
+        $response = $this->request()
+            ->get('/v2/catalogue', array_filter(['page' => $page, 'since' => $since]))
+            ->throw();
+
+        return [
+            'items' => $response->json('data', []),
+            'next_page' => $response->json('meta.next_page'),
+        ];
+    }
+
+    private function request(): PendingRequest
+    {
+        return Http::baseUrl((string) config('services.nordis.base_url'))
+            ->withToken($this->token)
+            ->acceptJson()
+            ->timeout(20);
+    }
+}
