diff --git a/api/tests/Feature/Account/CustomerLogoTest.php b/api/tests/Feature/Account/CustomerLogoTest.php
new file mode 100644
index 0000000..c9cb5a0
--- /dev/null
+++ b/api/tests/Feature/Account/CustomerLogoTest.php
@@ -0,0 +1,39 @@
+<?php
+
+declare(strict_types=1);
+
+use App\Models\Customer;
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Storage;
+
+beforeEach(function () {
+    Storage::fake('public');
+});
+
+it('enregistre le logo récupéré et son chemin sur le client', function () {
+    Http::fake([
+        'cdn.comptoir.example/*' => Http::response('octets-png', 200, ['Content-Type' => 'image/png']),
+    ]);
+    $customer = Customer::factory()->create();
+
+    $path = $this->actingAs($customer)
+        ->postJson('/api/me/logo', ['logo_url' => 'https://cdn.comptoir.example/clients/atelier-nord.png'])
+        ->assertCreated()
+        ->json('logo_path');
+
+    expect($path)->toStartWith('logos/')->toEndWith('.png');
+    Storage::disk('public')->assertExists($path);
+    expect($customer->fresh()->logo_path)->toBe($path);
+});
+
+it('exige une adresse de logo', function () {
+    $this->actingAs(Customer::factory()->create())
+        ->postJson('/api/me/logo', [])
+        ->assertUnprocessable()
+        ->assertJsonValidationErrors('logo_url');
+});
+
+it('exige une authentification', function () {
+    $this->postJson('/api/me/logo', ['logo_url' => 'https://cdn.comptoir.example/logo.png'])
+        ->assertUnauthorized();
+});
diff --git a/api/tests/Feature/Account/ProfileUpdateTest.php b/api/tests/Feature/Account/ProfileUpdateTest.php
new file mode 100644
index 0000000..aedabe1
--- /dev/null
+++ b/api/tests/Feature/Account/ProfileUpdateTest.php
@@ -0,0 +1,45 @@
+<?php
+
+declare(strict_types=1);
+
+use App\Models\Customer;
+
+it('met à jour le nom, la société et le téléphone du client connecté', function () {
+    $customer = Customer::factory()->create(['name' => 'Karim B.', 'phone' => null]);
+
+    $this->actingAs($customer)
+        ->patchJson('/api/me', [
+            'name' => 'Karim Benali',
+            'company' => 'Atelier Nord',
+            'phone' => '03 20 00 00 00',
+        ])
+        ->assertOk()
+        ->assertJsonPath('data.name', 'Karim Benali')
+        ->assertJsonPath('data.company', 'Atelier Nord')
+        ->assertJsonPath('data.phone', '03 20 00 00 00');
+
+    expect($customer->fresh()->name)->toBe('Karim Benali');
+});
+
+it('refuse une adresse e-mail déjà utilisée par un autre client', function () {
+    Customer::factory()->create(['email' => 'pris@exemple.test']);
+    $customer = Customer::factory()->create();
+
+    $this->actingAs($customer)
+        ->patchJson('/api/me', ['email' => 'pris@exemple.test'])
+        ->assertUnprocessable()
+        ->assertJsonValidationErrors('email');
+});
+
+it('accepte de conserver sa propre adresse e-mail', function () {
+    $customer = Customer::factory()->create(['email' => 'moi@exemple.test']);
+
+    $this->actingAs($customer)
+        ->patchJson('/api/me', ['email' => 'moi@exemple.test', 'name' => 'Moi'])
+        ->assertOk()
+        ->assertJsonPath('data.email', 'moi@exemple.test');
+});
+
+it('exige une authentification', function () {
+    $this->patchJson('/api/me', ['name' => 'Anonyme'])->assertUnauthorized();
+});
