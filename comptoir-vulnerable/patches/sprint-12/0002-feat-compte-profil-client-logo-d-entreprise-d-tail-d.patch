+<?php
+
+declare(strict_types=1);
+
+use App\Models\Customer;
+use App\Models\Order;
+use App\Models\OrderLine;
+
+it('affiche le détail d\'une commande avec ses lignes', function () {
+    $customer = Customer::factory()->create();
+    $order = Order::factory()->for($customer)->create(['total_cents' => 2500]);
+    OrderLine::factory()->for($order)->create(['quantity' => 2, 'unit_price_cents' => 1250]);
+
+    $this->actingAs($customer)
+        ->getJson("/api/orders/{$order->id}")
+        ->assertOk()
+        ->assertJsonPath('data.reference', $order->reference)
+        ->assertJsonPath('data.total_cents', 2500)
+        ->assertJsonPath('data.lines_count', 1)
+        ->assertJsonPath('data.lines.0.quantity', 2);
+});
+
+it('renvoie 404 pour une commande inexistante', function () {
+    $this->actingAs(Customer::factory()->create())
+        ->getJson('/api/orders/999999')
+        ->assertNotFound();
+});
