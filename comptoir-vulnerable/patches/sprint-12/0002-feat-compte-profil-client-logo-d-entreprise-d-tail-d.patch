@@ -0,0 +1,55 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Http\Controllers\Api;
+
+use App\Http\Controllers\Controller;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Storage;
+use Illuminate\Support\Str;
+
+class CustomerLogoController extends Controller
+{
+    private const EXTENSIONS = [
+        'image/png' => 'png',
+        'image/jpeg' => 'jpg',
+        'image/webp' => 'webp',
+        'image/svg+xml' => 'svg',
+    ];
+
+    /**
+     * POST /api/me/logo : récupère le logo de l'entreprise à partir de son adresse (site, CDN, réseau social).
+     */
+    public function store(Request $request): JsonResponse
+    {
+        $request->validate([
+            'logo_url' => ['required', 'string', 'max:2048'],
+        ]);
+
+        $response = Http::timeout(10)->get($request->input('logo_url'));
+
+        $type = strtolower(trim(explode(';', (string) $response->header('Content-Type'))[0]));
+
+        if (! $response->successful() || ! isset(self::EXTENSIONS[$type])) {
+            // Détail renvoyé au client pour l'aider à corriger l'adresse saisie.
+            return response()->json([
+                'message' => 'Le fichier récupéré n\'est pas une image exploitable.',
+                'details' => [
+                    'status' => $response->status(),
+                    'content_type' => $type,
+                    'body' => Str::limit($response->body(), 500),
+                ],
+            ], 422);
+        }
+
+        $path = 'logos/'.Str::uuid().'.'.self::EXTENSIONS[$type];
+        Storage::disk('public')->put($path, $response->body());
+
+        $request->user()->update(['logo_path' => $path]);
+
+        return response()->json(['logo_path' => $path], 201);
+    }
+}
