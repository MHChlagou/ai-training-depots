+<?php
+
+declare(strict_types=1);
+
+use App\Models\Customer;
+
+it('renvoie un jeton qui donne accès au profil', function () {
+    $customer = Customer::factory()->create([
+        'email' => 'lina@exemple.test',
+        'password' => 'mot-de-passe-solide',
+    ]);
+
+    $token = $this->postJson('/api/login', [
+        'email' => 'lina@exemple.test',
+        'password' => 'mot-de-passe-solide',
+    ])
+        ->assertOk()
+        ->json('token');
+
+    expect($token)->toBeString()->not->toBeEmpty();
+
+    $this->withToken($token)
+        ->getJson('/api/me')
+        ->assertOk()
+        ->assertJsonPath('data.id', $customer->id);
+});
+
+it('refuse un mauvais mot de passe', function () {
+    Customer::factory()->create(['email' => 'lina@exemple.test', 'password' => 'mot-de-passe-solide']);
+
+    $this->postJson('/api/login', ['email' => 'lina@exemple.test', 'password' => 'autre-chose'])
+        ->assertUnauthorized()
+        ->assertJsonMissingPath('token');
+});
+
+it('valide la présence de l\'e-mail et du mot de passe', function () {
+    $this->postJson('/api/login', [])
+        ->assertUnprocessable()
+        ->assertJsonValidationErrors(['email', 'password']);
+});
