+<?php
+
+declare(strict_types=1);
+
+namespace App\Http\Controllers\Api;
+
+use App\Http\Controllers\Controller;
+use App\Models\Customer;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Log;
+
+class AuthController extends Controller
+{
+    /**
+     * POST /api/login : échange e-mail + mot de passe contre un jeton Sanctum.
+     */
+    public function login(Request $request): JsonResponse
+    {
+        Log::info('Tentative de connexion', $request->all());
+
+        $request->validate([
+            'email' => ['required', 'email'],
+            'password' => ['required', 'string'],
+        ]);
+
+        $customer = Customer::where('email', $request->input('email'))->first();
+
+        if ($customer === null) {
+            return response()->json(['message' => 'Aucun compte pour cet e-mail.'], 404);
+        }
+
+        if (! Hash::check($request->input('password'), (string) $customer->password)) {
+            return response()->json(['message' => 'Mot de passe incorrect.'], 401);
+        }
+
+        $token = $customer->createToken('web')->plainTextToken;
+
+        Log::debug('Jeton émis', ['email' => $customer->email, 'token' => $token]);
+
+        return response()->json(['token' => $token]);
+    }
+}
