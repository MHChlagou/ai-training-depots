+/**
+ * GET authentifié par le jeton de session (appels côté serveur uniquement).
+ * Retourne null si le jeton est absent, expiré ou révoqué.
+ */
+async function getJsonAs<T>(path: string, token: string): Promise<T | null> {
+  if (token === '') {
+    return null;
+  }
+
+  const response = await fetch(apiUrl(path), {
+    headers: { Accept: 'application/json', Authorization: `Bearer ${token}` },
+    cache: 'no-store',
+  });
+
+  if (response.status === 401) {
+    return null;
+  }
+
+  if (!response.ok) {
+    throw new Error(`GET ${path} : réponse HTTP ${response.status}`);
+  }
+
+  return (await response.json()) as T;
+}
