+import { NextRequest } from 'next/server';
+import { describe, expect, it } from 'vitest';
+import { proxy } from './proxy';
+
+describe('proxy', () => {
+  it('redirige vers la connexion sans cookie de session', () => {
+    const response = proxy(new NextRequest('http://localhost/compte'));
+
+    expect(response.status).toBe(307);
+    expect(response.headers.get('location')).toBe('http://localhost/connexion?suite=%2Fcompte');
+  });
+
+  it('laisse passer une requête qui porte le cookie de session', () => {
+    const response = proxy(
+      new NextRequest('http://localhost/compte', { headers: { cookie: 'comptoir_session=abc' } }),
+    );
+
+    expect(response.headers.get('location')).toBeNull();
+    expect(response.headers.get('x-middleware-next')).toBe('1');
+  });
+});
