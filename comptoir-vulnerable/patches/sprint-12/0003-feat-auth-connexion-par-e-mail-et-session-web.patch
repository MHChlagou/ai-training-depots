+import { cookies } from 'next/headers';
+import { redirect } from 'next/navigation';
+import { getCurrentCustomer, getOrderStats } from '@/lib/api';
+import { formatPrice } from '@/lib/money';
+import { SESSION_COOKIE } from '@/lib/session';
+
+export const dynamic = 'force-dynamic';
+
+export default async function AccountPage() {
+  const token = (await cookies()).get(SESSION_COOKIE)?.value ?? '';
+  const customer = await getCurrentCustomer(token);
+
+  if (!customer) {
+    redirect('/connexion');
+  }
+
+  const stats = await getOrderStats(token);
+
+  return (
+    <main>
+      <h1>Mon compte</h1>
+      <dl className="account__facts">
+        <dt>Nom</dt>
+        <dd>{customer.name ?? '—'}</dd>
+        <dt>Société</dt>
+        <dd>{customer.company ?? '—'}</dd>
+        <dt>E-mail</dt>
+        <dd>{customer.email}</dd>
+        <dt>Téléphone</dt>
+        <dd>{customer.phone ?? '—'}</dd>
+      </dl>
+      {stats ? (
+        <section>
+          <h2>Mes commandes</h2>
+          <p>
+            {stats.orders_count} commande(s), {formatPrice(stats.total_spent_cents)} au total.
+          </p>
+          {stats.last_order_at ? (
+            <p>
+              Dernière commande le{' '}
+              {new Date(stats.last_order_at).toLocaleDateString('fr-FR', { dateStyle: 'long' })}.
+            </p>
+          ) : null}
+        </section>
+      ) : null}
+    </main>
+  );
+}
