+export const SESSION_COOKIE = 'comptoir_session';
+
+export type SessionResult = { ok: true } | { ok: false; message: string };
+
+/**
+ * Ouvre une session : le route handler /api/session échange les identifiants contre un jeton
+ * de l'API et le dépose dans le cookie de session.
+ */
+export async function openSession(email: string, password: string): Promise<SessionResult> {
+  let response: Response;
+  try {
+    response = await fetch('/api/session', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+      body: JSON.stringify({ email, password }),
+    });
+  } catch {
+    return { ok: false, message: 'Impossible de joindre le serveur. Réessayez dans un instant.' };
+  }
+
+  if (response.ok) {
+    return { ok: true };
+  }
+
+  const body = (await response.json().catch(() => null)) as { message?: unknown } | null;
+
+  return {
+    ok: false,
+    message: typeof body?.message === 'string' ? body.message : 'Connexion impossible.',
+  };
+}
